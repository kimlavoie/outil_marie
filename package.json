{
  "name": "outil-marie",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outil de gestion des activités, de la facturation et du rapprochement comptable",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript-native/bin/tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\" \"*.html\" \"*.scss\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx}\" \"*.html\" \"*.scss\"",
    "test": "node --test --test-force-exit test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
